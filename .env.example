# Copy to .env.local for local overrides, or configure in Netlify > Site settings > Environment variables.
# Solo variables con prefijo VITE_ se exponen al bundle del cliente.

# Muestra el bloque "Acceso rápido · Demo" en el Login (3 botones autofill por rol).
# Mantenerlo en "true" solo mientras no exista BE-01 (auth real). En dev siempre está visible.
VITE_SHOW_DEMO=true
