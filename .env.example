# Copy to .env.local for local overrides, or configure in Netlify > Site settings > Environment variables.
# Solo variables con prefijo VITE_ se exponen al bundle del cliente.

# Supabase Auth (#32). Con ambas definidas, el login usa Supabase y las cuentas mock dejan de funcionar.
# Usa solo la clave pública (anon/publishable). NUNCA pongas aquí la clave service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sin Supabase configurado: muestra el bloque "Acceso rápido · Demo" y permite las cuentas mock
# en builds de producción. En dev siempre está activo. Se ignora si Supabase está configurado.
VITE_SHOW_DEMO=true
